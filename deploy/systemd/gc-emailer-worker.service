[Unit]
Description=GC Emailer RQ workers
After=network-online.target postgresql.service redis-server.service

[Service]
User=gcemailer
Group=gcemailer
WorkingDirectory=/opt/gc-emailer/current
EnvironmentFile=/etc/gc-emailer/production.env
ExecStart=/opt/gc-emailer/venv/bin/rq worker --url ${REDIS_URL} campaigns validation maintenance
Restart=on-failure
RestartSec=5
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/gc-emailer /var/log/gc-emailer
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
