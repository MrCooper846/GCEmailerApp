APP_ENV=staging
SECRET_KEY=replace-with-a-different-random-secret
TOKEN_ENCRYPTION_KEY=replace-with-a-different-fernet-key
DATABASE_URL=postgresql+psycopg://gcemailer_staging:password@127.0.0.1/gcemailer_staging
REDIS_URL=redis://127.0.0.1:6379/1
STORAGE_ROOT=/var/lib/gc-emailer/staging
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://mailer-staging.gulfconferences.co.uk/oauth2/callback
ALLOWED_GOOGLE_DOMAIN=gulfconferences.co.uk
INITIAL_ADMIN_EMAILS=admin1@gulfconferences.co.uk,admin2@gulfconferences.co.uk
STAGING_SEND_ALLOWLIST=admin1@gulfconferences.co.uk,admin2@gulfconferences.co.uk
MAX_CAMPAIGN_RECIPIENTS=1500
RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
VALIDATION_POLICY=balanced
VALIDATION_ENABLE_SMTP=false
TRUST_PROXY=true
GUNICORN_BIND=127.0.0.1:8001
