APP_ENV=production
SECRET_KEY=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key
DATABASE_URL=postgresql+psycopg://gcemailer:password@127.0.0.1/gcemailer_production
REDIS_URL=redis://127.0.0.1:6379/0
STORAGE_ROOT=/var/lib/gc-emailer/production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://mailer.gulfconferences.co.uk/oauth2/callback
ALLOWED_GOOGLE_DOMAIN=gulfconferences.co.uk
INITIAL_ADMIN_EMAILS=admin1@gulfconferences.co.uk,admin2@gulfconferences.co.uk
MAX_CAMPAIGN_RECIPIENTS=1500
RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
VALIDATION_POLICY=balanced
VALIDATION_ENABLE_SMTP=false
TRUST_PROXY=true
GUNICORN_BIND=127.0.0.1:8000
