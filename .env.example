# Email Campaign Manager - Environment Variables

# Google OAuth (Workspace Internal)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/oauth2/callback

# Optional: legacy SMTP fallback (not used when Gmail OAuth is active)
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Flask Configuration
SECRET_KEY=change-this-to-a-random-secret-key

# Hosted application (use separate values for staging and production)
APP_ENV=development
DATABASE_URL=sqlite:///gcemailer.db
REDIS_URL=redis://127.0.0.1:6379/0
STORAGE_ROOT=instance/data
ALLOWED_GOOGLE_DOMAIN=gulfconferences.co.uk
INITIAL_ADMIN_EMAILS=admin1@gulfconferences.co.uk,admin2@gulfconferences.co.uk
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Multiple comma-separated keys support rotation; the first encrypts new values.
TOKEN_ENCRYPTION_KEY=
MAX_CAMPAIGN_RECIPIENTS=1500
MAX_CSV_ROWS=10000
RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
TRUST_PROXY=false
# Required in staging; staging can send tests only to these addresses.
STAGING_SEND_ALLOWLIST=

# Email validation defaults
# Syntax and DNS/mail-route checks always run. SMTP probing is opt-in.
VALIDATION_POLICY=balanced
VALIDATION_ENABLE_SMTP=false
# Required only when direct SMTP probing is enabled. Use a real address on a domain you control.
VALIDATION_MAIL_FROM=

# HTML Template Path (optional - only if you want to use external template)
# HTML_PATH=C:/path/to/your/template.html
